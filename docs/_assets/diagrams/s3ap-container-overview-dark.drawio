        <mxCell id="region" value="AWS リージョン" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#FFFFFF;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#4DD2D4;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;spacingTop=4;dashed=1;labelBackgroundColor=#232F3E;" vertex="1" parent="1">
