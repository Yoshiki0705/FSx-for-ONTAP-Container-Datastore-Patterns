        <mxCell id="cluster" value="Cluster (EKS Auto Mode, Kubernetes 1.36)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeColor=#666666;fillColor=none;fontColor=#232F3E;fontSize=16;verticalAlign=top;align=center;spacingTop=8;" vertex="1" parent="1">
